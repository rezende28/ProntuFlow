            fisicos += 1
            valor_total += float(s["valor"] or 0)
        else:
            digitais += 1

        # ================= POR MÊS =================
        try:
            mes = datetime.strptime(s["data_solicitacao"], "%Y-%m-%d").strftime("%Y-%m")
            por_mes[mes] = por_mes.get(mes, 0) + 1
