        senha = request.form.get("senha")
        perfil = request.form.get("perfil")

        conn = sqlite3.connect("docmed.db")
        c = conn.cursor()

        try:

            c.execute("""
            INSERT INTO usuarios
            (nome, usuario, senha, perfil)
            VALUES (?, ?, ?, ?)
