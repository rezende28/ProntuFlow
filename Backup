DIAS_PRAZO = 15

FERIADOS = [
    "01-01",
    "21-04",
    "01-05",
    "07-09",
    "12-10",
    "02-11",
    "15-11",
    "20-11",
    "25-12"
]

def eh_dia_util(data):
    if data.weekday() >= 5:
        return False

    if data.strftime("%d-%m") in FERIADOS:
        return False

    return True


def adicionar_dias_uteis(data_inicio, dias):
    data = data_inicio
    adicionados = 0

    while adicionados < dias:
        data += timedelta(days=1)

        if eh_dia_util(data):
            adicionados += 1

    return data

def cor_prazo(data_entrega):
    if not data_entrega:
        return "secondary"

    try:
        entrega = datetime.strptime(str(data_entrega), "%Y-%m-%d").date()
    except:
        return "secondary"

    hoje = date.today()
    diff = (entrega - hoje).days

    if diff < 0:
        return "danger"   # vermelho (atrasado)
    elif diff == 0:
        return "warning"  # laranja (hoje)
    else:
        return "success"  # verde (ok)
def formatar_data(data):
    if not data:
        return ""

    try:
        return datetime.strptime(str(data), "%Y-%m-%d").strftime("%d/%m/%Y")
    except:
        return data   
    
def mes_da_solicitacao(data_str):
    try:
        data = datetime.strptime(data_str, "%Y-%m-%d")
        return data.strftime("%Y-%m")
    except:
        return "Sem data"   
    
def listar_solicitacoes():
    conn = sqlite3.connect("docmed.db")
    conn.row_factory = sqlite3.Row
    c = conn.cursor()

    c.execute("SELECT * FROM solicitacoes ORDER BY id DESC")
    dados = c.fetchall()

    conn.close()
    return dados

def cor_status(status):
    if status == "⏳ Pendente":
        return "warning"   # amarelo
    elif status == "✅ Autorizado":
        return "success"   # verde
    elif status == "📦 Entregue":
        return "primary"   # azul
    elif status == "❌ Cancelado":
        return "danger"    # vermelho
    else:
        return "secondary"
    
def salvar_historico(solicitacao_id, acao, usuario="Sistema"):
    conn = sqlite3.connect("docmed.db")
    c = conn.cursor()

    c.execute("""
        INSERT INTO historico (solicitacao_id, data, usuario, acao)
        VALUES (?, ?, ?, ?)
    """, (
        solicitacao_id,
        datetime.now().strftime("%d/%m/%Y %H:%M"),
        usuario,
        acao
    ))

    conn.commit()
    conn.close()

def verificar_login(usuario, senha):

    conn = sqlite3.connect("docmed.db")
    c = conn.cursor()

    c.execute("""
        SELECT * FROM usuarios
        WHERE usuario = ? AND senha = ?
    """, (usuario, senha))

    user = c.fetchone()

    conn.close()

    return user

