    solicitacoes = c.fetchall()

    conn.close()

    total = len(solicitacoes)

    fisicos = 0
    digitais = 0
    valor_total = 0

    pendentes = 0
    atrasados = 0
    vencendo = 0
    cancelados = 0

    por_mes = {}

    hoje = date.today()

    for s in solicitacoes:

        if s["status"] == "⏳ Pendente":
            pendentes += 1
        elif s["status"] == "❌ Cancelado":
            cancelados += 1

        # 🔥 AQUI ESTÁ A CORREÇÃO: Só calcula atraso se NÃO estiver cancelado nem entregue
        if s["status"] not in ["❌ Cancelado", "📦 Entregue"]:
            try:
                if s["data_entrega"]:
                    entrega = datetime.strptime(s["data_entrega"], "%Y-%m-%d").date()
                    diff = (entrega - hoje).days

